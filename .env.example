# ============ 基础 ============
# 默认使用 SQLite（零配置）；生产环境可换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://whoop:whoop@localhost:5432/whoop_analyst
# DATABASE_URL=sqlite:///./data/whoop_analyst.db
TIMEZONE=Asia/Shanghai
# 前端地址（OAuth 完成后跳回这里）。开发模式 5173；Docker 单端口部署填 http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ WHOOP 开发者应用 ============
# 在 https://developer-dashboard.whoop.com 创建应用，Redirect URL 填下面的 WHOOP_REDIRECT_URI
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/api/whoop/auth/callback
# 首次连接时回填多少天历史数据
WHOOP_INITIAL_BACKFILL_DAYS=365

# ============ 大模型（可选） ============
# none：不调用大模型，使用规则引擎生成中文解读（全部统计功能可用）
# openai_compatible：DeepSeek / 通义千问 / Kimi / 智谱 / OpenAI 等兼容接口
# anthropic：Claude
LLM_PROVIDER=none

# --- DeepSeek ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 单次回复最大 token 数
LLM_MAX_TOKENS=4096
# --- OpenRouter（可用 Qwen / DeepSeek 等，key 以 sk-or-v1- 开头）---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.7-plus
# --- 通义千问（DashScope 兼容模式）---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# --- Kimi ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low / medium / high / xhigh / max
ANTHROPIC_EFFORT=medium
# 模型拒答时由服务端自动换模型接续（server-side fallback）
ANTHROPIC_ENABLE_FALLBACKS=true

AGENT_MAX_STEPS=8

# ============ 定时任务 ============
# 每天 DAILY_SYNC_HOUR 点自动同步 WHOOP + 生成日报；每周一生成上周周报
ENABLE_SCHEDULER=false
DAILY_SYNC_HOUR=9
